
@{
    ViewBag.Title = "Index";
}

<h2>Index</h2>
<p>@Html.ValidationSummary("",new {@class = "form-control text-danger" })</p>

@using (Html.BeginForm())
{
    <p>
        Enter Name: @Html.TextBox("FullName","", new { @class = "form-control"})
        @*@Html.ValidationMessage("Fullname", new { @class = "form-control text-danger" })*@
        <b style="color:red"> @ViewData["FullNameError"]</b>
    </p>
    <p>
        Enter Age: @Html.TextBox("Age", "", new { @class = "form-control" })
        @*@Html.ValidationMessage("Age", new { @class = "form-control text-danger" })*@
        <b style="color:red"> @ViewData["AgeError"]</b>

    </p>
    <p>
        Enter Email: @Html.TextBox("Email", "", new { @class = "form-control" })
        @*@Html.ValidationMessage("Email", new { @class = "form-control text-danger" })*@
        <b style="color:red"> @ViewData["EmailError"]</b>
    </p>

    <input type="submit" value="Submit" class="form-control btn btn-info" />
      @Html.Raw(ViewData["SuccessMessege"])
}