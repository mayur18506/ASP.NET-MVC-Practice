
@model List<_15.STRONGLY_TYPED_VIEW.Models.Employee>

@{
    ViewBag.Title = "Index";

    var a = (_15.STRONGLY_TYPED_VIEW.Models.Employee)ViewData["var1"];
    var b = ViewBag.Var2;
}

<h2>Index</h2>

<h1>ViewData Data</h1>

<h3>Id: @a.Id</h3>
<h3>Name: @a.Name</h3>
<h3>Age: @a.Age</h3>

<hr />

<h1>ViewBag Data</h1>

<h3>Id: @b.Id</h3>
<h3>Name: @b.Name</h3>
<h3>Age: @b.Age</h3>

<hr />

<h1>Strongly Typed View Data</h1>

<ul>
    @foreach (var employee in Model)
    {
        <li>
            Id: @employee.Id |
            Name: @employee.Name |
            Age: @employee.Age
        </li>
    }
</ul>
